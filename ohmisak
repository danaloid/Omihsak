local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
if not Rayfield then
    warn("Rayfield error")
    return
end

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packets = require(ReplicatedStorage.Shared.Packages.Packets)

local config = {
    radius = 8,
    speed = 2,
    isRunning = false,
    currentAngle = 0,
    centerPoint = nil,
    useVelocity = true
}


local function getVehicle()
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local seat = humanoid.SeatPart
            if seat then
                return seat.Parent
            end
        end
    end
    return nil
end

local function setThrottle(value)
    local interface = LocalPlayer.PlayerGui:FindFirstChild("Interface")
    if interface then
        interface:SetAttribute("MobileThrottle", value)
    end
end

local function setWheelieMode(mode)
    local interface = LocalPlayer.PlayerGui:FindFirstChild("Interface")
    if interface then
        local values = interface:FindFirstChild("Values")
        if values then
            local wheelieMode = values:FindFirstChild("WheelieMode")
            if wheelieMode then
                wheelieMode.Value = mode
            end
        end
    end
end

local function sendWheeliePacket()
    pcall(function()
        Packets.updateWheeliePacket:FireServer(45, tick() % 999, 3, true)
    end)
end

local function moveVehicle(vehicle, angle)
    if not config.centerPoint then return end
    local rad = math.rad(angle)
    vehicle:PivotTo(
        CFrame.new(
            config.centerPoint.X + math.cos(rad) * config.radius,
            config.centerPoint.Y,
            config.centerPoint.Z + math.sin(rad) * config.radius
        )
    )
    if config.useVelocity then
        local driveSeat = vehicle:FindFirstChild("DriveSeat")
        if driveSeat then
            driveSeat.AssemblyLinearVelocity = Vector3.new(
                math.sin(rad) * 35,
                0,
                -math.cos(rad) * 35
            )
        end
    end
end


local heartbeatConnection = nil
local statusLabel = nil
local vehicleLabel = nil

local function startFarming()
    local vehicle = getVehicle()
    if not vehicle then
        Rayfield:Notify({
            Title = "Error",
            Content = "Get in vehicle!",
            Duration = 3
        })
        return false
    end

    config.centerPoint = vehicle:GetPivot().Position
    config.currentAngle = 0
    config.isRunning = true

    setThrottle(1)
    setWheelieMode(true)

    local step = 360 / config.speed

    heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not config.isRunning then return end
        local veh = getVehicle()
        if not veh then return end

        config.currentAngle = (config.currentAngle + step * deltaTime) % 360
        moveVehicle(veh, config.currentAngle)
        sendWheeliePacket()
    end)

    Rayfield:Notify({
        Title = "Kashimo - Wheelie District",
        Content = "Farm Started!",
        Duration = 3
    })
    return true
end

local function stopFarming()
    config.isRunning = false
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
        heartbeatConnection = nil
    end
    setThrottle(0)
    setWheelieMode(false)

    local vehicle = getVehicle()
    if vehicle then
        local driveSeat = vehicle:FindFirstChild("DriveSeat")
        if driveSeat then
            driveSeat.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    Rayfield:Notify({
        Title = "Kashimo - Wheelie District",
        Content = "Farm stopped",
        Duration = 2
    })
end


local Window = Rayfield:CreateWindow({
    Name = "Kashimo - Wheelie District",
